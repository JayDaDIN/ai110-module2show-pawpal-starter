classDiagram
    %% PawPal+ — four classes, one per core action of the system.
    %% CareTask tracks work, Owner holds constraints, Scheduler plans and explains.
    %% All four are Python @dataclass types, defined in pawpal_system.py.
    %% On Scheduler, `scheduled`, `skipped` and `planned` are results of
    %% build_plan(), not constructor parameters (field(init=False)).

    class CareTask {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str recurrence
        +priority_score() int
        +sort_key() tuple
    }

    class Pet {
        +str name
        +str species
        +str breed
        +str energy_level
        +list~CareTask~ tasks
        +add_task(task) CareTask
        +remove_task(title) bool
        +tasks_by_category(category) list~CareTask~
        +total_task_minutes() int
    }

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferred_times
        +bool skip_low_priority
        +has_capacity_for(minutes_used, task) bool
        +minutes_remaining(minutes_used) int
        +prefers(task) bool
    }

    class Scheduler {
        +Owner owner
        +Pet pet
        +list~dict~ scheduled
        +list~dict~ skipped
        +bool planned
        +build_plan() list~dict~
        +explain() list~str~
        +total_scheduled_minutes() int
        -_sort_tasks(tasks) list~CareTask~
        -_reason_for(task) str
        -_advance_time(clock, minutes) str
    }

    Pet "1" *-- "0..*" CareTask : owns
    Scheduler --> Owner : reads constraints from
    Scheduler --> Pet : plans tasks for
